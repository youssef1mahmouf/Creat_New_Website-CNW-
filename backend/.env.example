# ================= CNW Backend Environment =================
# Copy to .env and fill values. NEVER commit .env.
#
# REQUIRED (production cannot start without these):
#   NODE_ENV, PORT, DB_TYPE, JWT_SECRET, SESSION_SECRET,
#   MONGODB_URI + MONGODB_DB_NAME (when DB_TYPE=mongodb),
#   ENCRYPTION_KEY_CURRENT, CORS_ORIGINS, CLIENT_URL
# OPTIONAL: everything else (safe defaults are applied).
# DEVELOPMENT-ONLY: MAIL_DEV_TOKENS, MANUAL_PAYMENTS_ALLOW, DB_FALLBACK_JSON.

PORT=5000
NODE_ENV=development

# ---- Database ----
# "json" (development store) or "mongodb" (production).
# Production NEVER silently falls back to JSON; set DB_FALLBACK_JSON=false
# to disable the (dev-only) fallback entirely.
DB_TYPE=json
DB_FALLBACK_JSON=true
MONGODB_URI=mongodb://localhost:27017/cnw
MONGODB_DB_NAME=cnw

# ---- Secrets (generate each value independently) ----
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=
PASSWORD_PEPPER=
ENCRYPTION_KEY_CURRENT=
# Leave empty on a new installation. Only set to the previous key during rotation.
ENCRYPTION_KEY_PREVIOUS=
BACKUP_ENCRYPTION_KEY=
# Bootstrap super-admin (set SEED_ADMIN_PASSWORD in production!)
SEED_ADMIN_EMAIL=admin@cnw.local
SEED_ADMIN_PASSWORD=

# ---- AI (backend only; keys never reach the frontend) ----
# Provider abstraction: OpenAI first, Google Gemini fallback, offline otherwise.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
CLIENT_URL=http://localhost:5173
# Set true only when a trusted reverse proxy is in front of the backend.
TRUST_PROXY=false

# ---- Auth / tokens ----
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL_DAYS=7
RESET_TOKEN_TTL_MINUTES=30

# ---- Email (SMTP). MAIL_ENABLED=true activates real delivery. ----
# In production, MAIL_ENABLED without host/user/pass fails CLOSED (marked
# failed in the outbox) — it never silently pretends delivery succeeded.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false
MAIL_FROM=CNW <no-reply@cnw.local>
# DEVELOPMENT-ONLY: returns password-reset / verification tokens in API
# responses so flows stay testable without SMTP. NEVER enable in production.
MAIL_DEV_TOKENS=false
MAIL_RETRY_MAX=3

# ---- SMS (optional) ----
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_CUSTOM_URL=
SMS_CUSTOM_API_KEY=
ADMIN_EMAIL=
ADMIN_PHONE=

# ---- Redis (optional; shared brute-force counters / rate-limit state) ----
REDIS_ENABLED=false
REDIS_URL=
REDIS_PREFIX=cnw

# ---- Payments ----
# DEVELOPMENT-ONLY: allows the mock "manual" settlement provider in production.
# Real providers (Stripe/PayPal) plug into src/controllers/order.controller.js.
MANUAL_PAYMENTS_ALLOW=false

# ---- Files ----
# Local storage directory for chat attachments / digital files.
FILE_STORAGE_DIR=

# ---- i18n ----
I18N_DEFAULT_LOCALE=en
I18N_SUPPORTED=en,ar

# ---- Feature flags ----
FEATURE_AI_USER_CHAT=true
FEATURE_AI_ADMIN_CHAT=true
FEATURE_AI_BUILDER=true
FEATURE_CODE_STORE=true
FEATURE_SUBSCRIPTIONS=true
FEATURE_CHAT=true
FEATURE_REPORTS=true

# ---- Error reporting ----
CLIENT_ERROR_LIMIT=20

# ---- Logging ----
LOG_FORMAT=pretty
LOG_LEVEL=info
